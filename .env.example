# pdf2zh 环境变量模板 —— 复制为 .env 后填值
#
# 优先级：显式参数 > .secrets/*.json > 环境变量 > 本文件 > 内置预设
# .env 已被 .gitignore，不会进 git。
#
# 真实密钥建议放 .secrets/ 而不是这里：
#   .secrets/minimax.json  {"key": "sk-..."}
#   .secrets/mineru.json   {"token": "..."}
# 本文件只放端点、模型名这类非敏感配置。

# ───────────────────────────────────────────────
# 翻译后端（默认 minimax，即本地已配置好的 MiniMax-M3）
# ───────────────────────────────────────────────

# MiniMax 官方（默认）
# https://platform.minimaxi.com
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
# MINIMAX_API_KEY=sk-...        # 不填则读 .secrets/minimax.json 的 key

# DeepSeek 官方
# https://platform.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_API_KEY=sk-...

# OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=stealth/ox-alpha
# OPENROUTER_API_KEY=sk-or-...

# Ollama 本地（先 `ollama pull qwen2.5:14b`）
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_API_KEY=ollama          # 任意非空字符串，OpenAI SDK 拒绝空值

# LM Studio 本地（先在 Developer 页签启动 Local Server）
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=                # 留空则需命令行 --model 指定
LMSTUDIO_API_KEY=lm-studio

# ───────────────────────────────────────────────
# MinerU 云 OCR
# ───────────────────────────────────────────────
# token 放 .secrets/mineru.json 的 "token" 字段，或用下面的环境变量。
# 申请：https://mineru.net/apiManage/token
# MINERU_TOKEN=...

# ───────────────────────────────────────────────
# 输出根目录（可选）
# 命令行默认 ./output，Web UI 默认 <项目>/output
# ───────────────────────────────────────────────
# PDF2ZH_OUTPUT_ROOT=/Users/xbpd/Projects/pdf2zh/output

# Web UI 端口（默认 7862）
# PDF2ZH_PORT=7862
